<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ için yedekleme ve cihaz transferi kuralları.

    Yalnızca kullanıcı tercihleri taşınır. <include> listelenmeyen her şeyi
    otomatik olarak hariç tuttuğu için tarama önbelleği ve çöp kutusundaki
    (kullanıcının silmek istediği) dosyalar aktarılmaz.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
