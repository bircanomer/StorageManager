<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep space base -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF1E1748" />
                <item android:offset="0.55" android:color="#FF120E2E" />
                <item android:offset="1.0" android:color="#FF06040F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft brand glow so the ring sits on light, not on flat black -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="52">
                <item android:offset="0.0" android:color="#386C63FF" />
                <item android:offset="1.0" android:color="#006C63FF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
