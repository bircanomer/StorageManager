<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: storage gauge ring + AI sparkle.
    Everything stays inside the 66dp safe circle (radius 33 around 54,54)
    so no launcher mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient glow behind the ring -->
    <path android:pathData="M 54,20 A 34,34 0 1 1 53.99,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0.0" android:color="#3300BCD4" />
                <item android:offset="0.6" android:color="#1A6C63FF" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gauge track (full ring) -->
    <path
        android:pathData="M 54,27 A 27,27 0 1 1 53.99,27 Z"
        android:strokeWidth="10"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.13" />

    <!-- Gauge progress arc: 260 degrees clockwise from the top -->
    <path
        android:pathData="M 54,27 A 27,27 0 1 1 27.41,58.69"
        android:strokeWidth="10"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="81"
                android:startY="30"
                android:endX="30"
                android:endY="78">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="0.55" android:color="#FF00BCD4" />
                <item android:offset="1.0" android:color="#FF6C63FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center sparkle: the "AI clean" mark -->
    <path
        android:pathData="M 54,38 C 55.8,47.6 60.4,52.2 70,54 C 60.4,55.8 55.8,60.4 54,70 C 52.2,60.4 47.6,55.8 38,54 C 47.6,52.2 52.2,47.6 54,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="42"
                android:startY="40"
                android:endX="66"
                android:endY="68">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFC9F7FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Freed-up space: two sparkles sitting in the ring's open gap -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M 33,31 C 33.8,35.2 35.8,37.2 40,38 C 35.8,38.8 33.8,40.8 33,45 C 32.2,40.8 30.2,38.8 26,38 C 30.2,37.2 32.2,35.2 33,31 Z" />
    <path
        android:fillColor="#00E5FF"
        android:fillAlpha="0.9"
        android:pathData="M 44,24 C 44.5,26.5 45.5,27.5 48,28 C 45.5,28.5 44.5,29.5 44,32 C 43.5,29.5 42.5,28.5 40,28 C 42.5,27.5 43.5,26.5 44,24 Z" />

</vector>
